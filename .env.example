# Copiar a .env y completar. El .env nunca se commitea (esta en .gitignore).
#
#   cp .env.example .env
#   docker compose up --build
#
# Docker Compose lee el .env de esta carpeta y pasa las variables a los servicios.

# --- Obligatoria ---
# El indice del corpus se construye y se consulta con embeddings de OpenAI, asi que esta
# clave hace falta incluso si el chat corre con otro proveedor.
OPENAI_API_KEY=

# --- Proveedor de chat ---
# openai (por defecto) o anthropic. Cambia que cliente construye los tres modelos.
LLM_PROVIDER=openai
# Solo si LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# --- Modelos ---
# Vacios, cada rol usa el modelo por defecto de su proveedor: gpt-4o-mini en OpenAI,
# claude-haiku-4-5 en Anthropic. Se configuran por separado para poder darle al supervisor
# o al redactor un modelo distinto del de los especialistas.
MODELO_SUPERVISOR=
MODELO_INVESTIGADOR=
MODELO_REDACTOR=
MODELO_EMBEDDINGS=text-embedding-3-small
TEMPERATURA=0

# --- Infraestructura ---
# Dentro del compose es el nombre del servicio; fuera, localhost.
REDIS_URL=redis://localhost:6379/0
NOMBRE_COLECCION=csjn_sentencias_arbitrarias
# Donde vive el indice. Dentro del compose tiene que coincidir con el volumen `indice`, que
# se monta en /srv/vectorstore: cambiarla ahi haria que el indice se reconstruya en cada
# arranque, porque el volumen dejaria de tapar el directorio real.
DIRECTORIO_VECTORSTORE=

# --- Observabilidad ---
# Sin esta clave el sistema arranca igual y avisa que corre sin trazas: un proceso que no
# levanta porque falta su telemetria es peor que uno sin telemetria.
LANGSMITH_API_KEY=
PROYECTO_LANGSMITH=orquestador-rex-final
